# --- Database -----------------------------------------------------------------
# Connection string consumed by the api service and by sqlx::migrate! at
# startup. Match POSTGRES_PASSWORD below.
DATABASE_URL=postgres://genuflow:changeme@localhost:5432/genuflow
POSTGRES_PASSWORD=changeme

# --- API server ---------------------------------------------------------------
API_PORT=8080
RUST_LOG=info

# --- Sessions -----------------------------------------------------------------
# HS256 signing secret for session JWTs (gf_session cookie). Use a string of
# at least 32 bytes of entropy in production.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Whether the session cookie carries the Secure flag. true in production
# (HTTPS-only), false for local HTTP development.
COOKIE_SECURE=false

# --- Public URLs --------------------------------------------------------------
# Origin used to construct user-facing URLs (e.g. the verify URL encoded into
# product QR codes). No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

# --- Base anchoring -----------------------------------------------------------
# Base mainnet RPC. Use https://sepolia.base.org for testnet development.
BASE_RPC_URL=https://mainnet.base.org
# Hex private key for the anchor wallet, no 0x prefix. Wallet must hold ETH
# on Base for gas; Genuflow absorbs anchor costs on behalf of brands.
ANCHOR_PRIVATE_KEY=your_hex_private_key_here

# --- Stripe (optional; falls back to placeholder mode when unset) -------------
# When STRIPE_SECRET_KEY is set, /v1/billing/create-checkout-session hits the
# real Stripe API and /webhooks/stripe verifies signatures. When unset,
# billing endpoints run in placeholder mode so the frontend flow remains
# testable without a Stripe account.
# STRIPE_SECRET_KEY=sk_live_or_test_key
# STRIPE_WEBHOOK_SECRET=whsec_secret_from_stripe_dashboard
# STRIPE_PRICE_ID_MAISON=price_maison_id
# STRIPE_PRICE_ID_COUTURE=price_couture_id

# --- Frontend (Next.js) -------------------------------------------------------
# Server-side base for /api/* proxy. Set on the Next.js process, not on the
# api service. Browser requests always go through the same-origin /api proxy.
INTERNAL_API_URL=http://localhost:8081

# Absolute origin used by metadata (Open Graph URLs, sitemap). Defaults to
# the production URL when unset; override for staging environments.
# NEXT_PUBLIC_SITE_URL=https://genuflow.com

# --- Email (Resend) -----------------------------------------------------------
# API key for transactional email. When unset, the /api/contact route logs
# the submission to stdout and returns 200 — the marketing form remains
# testable in dev without a Resend account.
# RESEND_API_KEY=re_your_api_key
